<?xml version="1.0" encoding="utf-8" ?>
<Defs>
<!--Crafteos normales-->
<!--===================CRAFT 6 BASIC==================-->
    <RecipeDef>
        <defName>CH_CraftCanister_basic</defName>
        <label>synthesize 6 economic hp serums</label>
        <recipeUsers>
            <li>DrugLab</li>
        </recipeUsers>
        <workAmount>1500</workAmount>
        <researchPrerequisite>CH_Research_economicsubstance</researchPrerequisite>
        <skillRequirements>
            <Crafting>3</Crafting>
            <Intellectual>3</Intellectual>
        </skillRequirements>
        <workSkill>Intellectual</workSkill>
        <displayPriority>100</displayPriority>

        <ingredients>
            <li>
                <filter>
                    <thingDefs>
                        <li>Steel</li>
                    </thingDefs>
                </filter>
                <count>3</count>
            </li>
            <li>
                <filter>
                    <thingDefs>
                        <li>Silver</li>
                    </thingDefs>
                </filter>
                <count>1</count>
            </li>
            <li>
                <filter>
                    <thingDefs>
                        <li>PsychoidLeaves</li>
                    </thingDefs>
                </filter>
                <count>8</count>
            </li>
            <li>
                <filter>
                    <thingDefs>
                        <li>MedicineHerbal</li>
                    </thingDefs>
                </filter>
                <count>3</count>
            </li>
        </ingredients>
        <products>
                <CH_HealingCanister_Basic>6</CH_HealingCanister_Basic>
        </products>
    </RecipeDef>

