			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile>
			<damageDef>CH_Healing</damageDef>
			<damageAmountBase>1</damageAmountBase>
			<speed>120</speed>
		</projectile>
	</ThingDef>
	
	<ThingDef ParentName="BaseGun">
		<defName>CH_MedicGun_MechRifle</defName>
		<label>Chinis Mender</label>
		<description>A Mechanoid manufactured dart gun, installs a new algorithm in HP compound mechanites to make them able to heal mechs damaged parts, not enough to heal destroyed parts</description>
		
		<graphicData>
			<texPath>Things/WeaponRange/MedicGun_MechRifle</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>

		<techLevel>Spacer</techLevel>
		<tradeability>None</tradeability>
		<destroyOnDrop>true</destroyOnDrop>
		<relicChance>0</relicChance>
		
		<statBases>
			<MarketValue>1400</MarketValue>
			<Mass>2.6</Mass>
			<AccuracyTouch>1</AccuracyTouch>
			<AccuracyShort>0.95</AccuracyShort>
			<AccuracyMedium>0.90</AccuracyMedium>
			<AccuracyLong>0.85</AccuracyLong>
			<RangedWeapon_Cooldown>2.1</RangedWeapon_Cooldown>
		</statBases>
		<weaponClasses>
			<li>RangedLight</li>
		</weaponClasses>
		<weaponTags>
			<li>MechanoidMedicgun</li>
			<li>CombatHealingWeapon</li>
		</weaponTags>

		<verbs>
			<li>
				<verbClass>CombatHealing.Verb_ShootCH</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>CH_Chilinisbullet_MechRifle</defaultProjectile>
				<warmupTime>0.4</warmupTime>
				<range>26</range>
				<soundCast>CH_DartShot</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>1</muzzleFlashScale>

				<burstShotCount>2</burstShotCount>
        		<ticksBetweenBurstShots>14</ticksBetweenBurstShots>
			</li>
		</verbs>
		
		<tools>
			<li>
				<label>stock</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>9</power>
				<cooldownTime>1.55</cooldownTime>
			</li>
			<li>
				<label>muzzle</label>
				<capacities>
					<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>1.55</cooldownTime>
			</li>
		</tools>
		<comps>
			<li Class="CombatHealing.CompProperties_CHFuel">
				<capacity>100</capacity>
				<consumption>1</consumption>
				<baseHealAmount>3</baseHealAmount>
				<totalHeals>2</totalHeals>
				<partHeals>1</partHeals>
				<canHealMechs>true</canHealMechs>
			</li>
		</comps>
  </ThingDef>


</Defs>