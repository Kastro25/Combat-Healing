<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!--====================================================== MEDIRAY ======================================================-->
	<ThingDef ParentName="BaseBullet">
		<defName>CH_Beam_MediRay</defName>
		<label>MediRay Beam</label>
		<graphicData>
			<texPath>Things/Projectile/Beam_MediRay</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile>
			<damageDef>CH_Healing</damageDef>
			<damageAmountBase>1</damageAmountBase>
			<speed>55</speed>
		</projectile>
	</ThingDef>

	<ThingDef ParentName="BaseHumanMakeableGun">
		<defName>CH_MedicGun_MediRay</defName>
		<label>Laotar Mediray</label>
		<description>tf2 medigun</description>
		<descriptionHyperlinks>
            <ThingDef>CH_HealingCanister_Basic</ThingDef>
            <ThingDef>CH_HealingCanister</ThingDef>   
            <ThingDef>CH_HealingCanister_Advanced</ThingDef>   
        </descriptionHyperlinks>
		<graphicData>
			<texPath>Things/WeaponRange/MedicGun_MediRay</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>1.2</drawSize>
		</graphicData>
		
		<recipeMaker>
				<researchPrerequisites>
					<li>CH_Research_medicrays</li>
				</researchPrerequisites>
			<recipeUsers>
        		<li>TableMachining</li>
      		</recipeUsers>
			<skillRequirements>
				<Crafting>8</Crafting>
			</skillRequirements>
			<displayPriority>420</displayPriority>
		</recipeMaker>
		<costList>
			<Steel>80</Steel>
			<ComponentIndustrial>3</ComponentIndustrial>
		</costList>
		<smeltable>true</smeltable>

		<soundInteract>Interact_Rifle</soundInteract>
		<techLevel>Industrial</techLevel>
		
		<statBases>	 
			<WorkToMake>24000</WorkToMake>
			<Mass>2</Mass>
			<AccuracyTouch>1</AccuracyTouch>
			<AccuracyShort>1</AccuracyShort>
			<AccuracyMedium>1</AccuracyMedium>
			<AccuracyLong>1</AccuracyLong>
			<RangedWeapon_Cooldown>0</RangedWeapon_Cooldown>
			<MarketValue>600</MarketValue>
		</statBases>
		
		<verbs>
			<li>
				<verbClass>CombatHealing.Verb_ShootCH_Beam</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>CH_Beam_MediRay</defaultProjectile>
				<warmupTime>0</warmupTime>
				<range>8</range> <!--Rango del SMG pesado: 23 casillas-->
				<soundCast>CH_DartShot</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>1</muzzleFlashScale>

				<burstShotCount>10</burstShotCount>
        		<ticksBetweenBurstShots>3</ticksBetweenBurstShots>
			</li>
		</verbs>
		<!--Recordatorio de no confundir weaponClasses con weaponTags, weaponClasses define como se comporta un pawn con ese arma-->
		<weaponClasses>
			<li>ShortShots</li> <!--Segun oscar postoski short shots pertenece para el máximo rango del SMG pesado, nota para tener en cuenta -->
			
		</weaponClasses>
		<weaponTags> 
			<li>ShortShots</li> <!--Se supone que  con esto el arma puede aparecer en lugar de smgs pesados y escopetas-->
			<li>CombatHealingWeapon</li><!--Para el que esté leyendo esto, este tag es para que el arma tenga el comportamiento de disparar a sus aliados, osea que si le pones esto a un rifle, tu pawn va a matar a sus amigos xD-->
		</weaponTags>
		<tradeTags> 
			<li>WeaponRanged</li>
		</tradeTags>
		<thingSetMakerTags>
    		<li>RewardStandardMidFreq</li>
		</thingSetMakerTags>
		
		<tools>
			<li>
				<label>stock</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>9</power>
				<cooldownTime>1.55</cooldownTime>
			</li>
			<li>
				<label>muzzle</label>
				<capacities>
					<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>1.55</cooldownTime>
			</li>
		</tools>

		<comps>
			<li Class="CombatHealing.CompProperties_CHFuel">
				<capacity>1000</capacity>
				<consumption>1</consumption>
				<baseHealAmount>0.1</baseHealAmount>
				<totalHeals>1</totalHeals>
				<partHeals>1</partHeals>
				<canHealMechs>false</canHealMechs>
			</li>
			<li Class="CombatHealing.CompProperties_CHHypercharge">
				<maxCharge>100</maxCharge>
				<chargeCost>100</chargeCost>
				<chargePerHealPoint>10</chargePerHealPoint>
				<hediffToApply>CH_Hypercharged</hediffToApply>
				<range>20</range>
				<cooldownTicks>1800</cooldownTicks>
				<abilityLabel>Hypercharge</abilityLabel>
				<abilityDesc>Vuelve hypercharged al objetivo por 10 segundos.</abilityDesc>
				<abilityIconPath>UI/Icons/CH_Hypercharge</abilityIconPath>
    		</li>
		</comps>
	</ThingDef>

</Defs>