		<recipeMaker>
			<recipeUsers>
				<li>DrugLab</li>
			</recipeUsers>
			<workAmount>12000</workAmount>
			<researchPrerequisite>CH_Research_economicsubstance</researchPrerequisite>
			<skillRequirements>
				<Crafting>4</Crafting>
				<Intellectual>4</Intellectual>
			</skillRequirements>
			<workSkill>Intellectual</workSkill>
			<displayPriority>420</displayPriority>
		</recipeMaker>
		<costList>
			<Steel>5</Steel>
			<Silver>1</Silver>
			<PsychoidLeaves>8</PsychoidLeaves>
			<MedicineHerbal>2</MedicineHerbal>
		</costList>
	</ThingDef>

