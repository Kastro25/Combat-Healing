<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!-- Mendoria -->
	<ThingDef ParentName="BaseMechanoid">
		<defName>CH_Mendoria</defName>
		<label>mendoria</label>
		<description>Mendoria is a medical support mechanoid developed to accompany combat squads on frontier worlds, where their major threats made it no longer feasible to evacuate and care for the wounded. They are equipped with a LED display, propellers for fast movement and a Chinis weapon, but they are helpless when alone, incapable of defend themselves. Many centuries ago after a terrible defeat numerous Mendorias went lost in the mech frontier, mech hive appropriated, repurposed and replicated them for its own forces, since then they were able to heal other mechanoids. \n<color #cbff52>Gameplay effect:</color> \nMendoria can heal both organic beings and mechanoids via shooting them. With Vanilla Expanded Framework she ignores terrain movement</description>
		<graphicData>
        	<texPath>Things/Pawn/Mechanoid/CH_MechMendoria/CH_Mendoria</texPath>
        	<graphicClass>Graphic_Multi</graphicClass>
    	</graphicData>
		
		<statBases>
			<MoveSpeed>6</MoveSpeed>
			<MarketValue>1600</MarketValue>
			<ArmorRating_Blunt>0.3</ArmorRating_Blunt>
			<ArmorRating_Sharp>0.50</ArmorRating_Sharp>
			<MechEnergyLossPerHP>0.75</MechEnergyLossPerHP>
			 <BandwidthCost>3</BandwidthCost>
		</statBases>
		<tools>
			<li>
				<label>head</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>8</power>
				<cooldownTime>2.6</cooldownTime>
				<linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
				<ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
			</li>
		</tools>
		<race>
			<body>Mech_Light</body>
			<intelligence>ToolUser</intelligence>
			<thinkTreeMain>Mechanoid</thinkTreeMain>
			<baseBodySize>1</baseBodySize>
			<soundMeleeHitPawn>Pawn_Melee_Punch_HitPawn</soundMeleeHitPawn>
			<soundMeleeHitBuilding>Pawn_Melee_MechanoidBash_HitBuilding</soundMeleeHitBuilding>
			<soundMeleeMiss>Pawn_Melee_Punch_Miss</soundMeleeMiss>
			<mechWeightClass>Light</mechWeightClass>
			<lifeStageAges>
				<li>
					<def>MechanoidFullyFormed</def>
					<minAge>0</minAge>
					<soundWounded>Pawn_Mech_Militor_Wounded</soundWounded>
					<soundDeath>Pawn_Mech_Militor_Death</soundDeath>
					<soundCall>Pawn_Mech_Militor_Call</soundCall>
