<Defs>

	<!-- Mendoria -->
	<ThingDef ParentName="BaseMechanoid">
		<defName>CH_Mendoria</defName>
		<label>mendoria</label>
		<description>Mendoria is a medical support mechanoid developed to accompany combat squads on active battlefields, where the growing threat of enemy forces made evacuating and treating the wounded increasingly impossible. Equipped with a LED display, propellers, and a Chinis weapon, Mendoria excels at keeping allies alive, but it is virtually defenseless when left alone. Its cheerful appearance was designed to keep soldiers morale high in even the most hostile environments (With the help of a small psychic device). Long time ago, after a terrible defeat many Mendorias were lost in the mech frontier, the Mech hive appropriated, repurposed, corrupted and replicated them for heal its own forces, Mech hive Mendorias are very disturbing since their mini psychic device was altered. Those new features were consequently copied by the human designed Mendorias.\n\n&lt;color=#cbff52&gt;Gameplay effect:&lt;/color&gt; \n\nMendorias can heal both organic beings and mechanoids. Thanks to their implanted psychic device and cute appearance she provides a mood boost to nearby allies and sends disturbing signals to enemies reducing their mood. With Vanilla Expanded Framework she ignores terrain movement.</description>
		<graphicData>
        	<texPath>Things/Pawn/Mechanoid/CH_MechMendoria/CH_Mendoria</texPath>
        	<graphicClass>Graphic_Multi</graphicClass>
    	</graphicData>
		
		<statBases>
			<MoveSpeed>4.7</MoveSpeed>
			<MarketValue>1200</MarketValue>
			<ArmorRating_Blunt>0.21</ArmorRating_Blunt>
			<ArmorRating_Sharp>0.67</ArmorRating_Sharp>
			<MechEnergyLossPerHP>0.75</MechEnergyLossPerHP>
			 <BandwidthCost>3</BandwidthCost>
		</statBases>
		<tools>
			<li>
				<label>head</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>8</power>
				<cooldownTime>2.6</cooldownTime>
				<linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
				<ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
			</li>
		</tools>
		<race>
			<body>Mech_Light</body>
			<intelligence>ToolUser</intelligence>
			<thinkTreeMain>Mechanoid</thinkTreeMain>
