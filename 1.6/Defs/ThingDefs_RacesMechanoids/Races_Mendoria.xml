<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!-- Mendoria -->
	<ThingDef ParentName="BaseMechanoid">
		<defName>CH_Mendoria</defName>
		<label>mendoria</label>
		<description>Mendoria is a medical support mechanoid developed to accompany combat squads on active battlefields where their major threats made it no longer feasible to evacuate and care for the wounded. They are equipped with a LED display, propellers for fast movement and a Chinis weapon, but they are helpless when alone, incapable of defend themselves. Its design was intended to boost troop morale in a completely hostile environment were a friendly face was a source of motivation.Long time ago after a terrible defeat numerous Mendorias went lost in the mech frontier, the Mech hive appropriated, repurposed, corrupted and replicated them for its own forces, Mech hive Mendorias are are very disturbing and uncanny, but they now serve a way to healing other mechanoids which was consequently copied by the human designed Mendorias.\n\n&lt;color=#cbff52&gt;Gameplay effect:&lt;/color&gt; \n\nMendorias can heal both organic beings and mechanoids via shooting them. Thanks to its adorable design Mendoria provide a mood boost to nearby allies, however, an enemy Mendoria is disturbing, and nearby pawns will receive a mood debuff, your Mendorias can disturb enemies. With Vanilla Expanded Framework she ignores terrain movement.</description>
		<graphicData>
        	<texPath>Things/Pawn/Mechanoid/CH_MechMendoria/CH_Mendoria</texPath>
        	<graphicClass>Graphic_Multi</graphicClass>
    	</graphicData>
		
		<statBases>
			<MoveSpeed>4.7</MoveSpeed>
			<MarketValue>1200</MarketValue>
			<ArmorRating_Blunt>0.21</ArmorRating_Blunt>
			<ArmorRating_Sharp>0.67</ArmorRating_Sharp>
			<MechEnergyLossPerHP>0.75</MechEnergyLossPerHP>
			 <BandwidthCost>3</BandwidthCost>
		</statBases>
		<tools>
			<li>
				<label>head</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>8</power>
				<cooldownTime>2.6</cooldownTime>
				<linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
				<ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
			</li>
		</tools>
		<race>
			<body>Mech_Light</body>
			<intelligence>ToolUser</intelligence>
			<thinkTreeMain>Mechanoid</thinkTreeMain>
			<baseBodySize>1</baseBodySize>
			<soundMeleeHitPawn>Pawn_Melee_Punch_HitPawn</soundMeleeHitPawn>
			<soundMeleeHitBuilding>Pawn_Melee_MechanoidBash_HitBuilding</soundMeleeHitBuilding>
			<soundMeleeMiss>Pawn_Melee_Punch_Miss</soundMeleeMiss>
			<mechWeightClass>Light</mechWeightClass>
			<lifeStageAges>
				<li>
					<def>MechanoidFullyFormed</def>
					<minAge>0</minAge>
					<soundWounded>Pawn_Mech_Mendoria_Wounded_Clean</soundWounded>
					<soundDeath>Pawn_Mech_Mendoria_Death_Clean</soundDeath>
					<soundCall>Pawn_Mech_Mendoria_Call_Clean</soundCall>
				</li>
				<li>
					<def>MechanoidFullyFormed</def>
					<minAge>100</minAge>
					<soundWounded>Pawn_Mech_Mendoria_Wounded</soundWounded>
					<soundDeath>Pawn_Mech_Mendoria_Death</soundDeath>
					<soundCall>Pawn_Mech_Mendoria_Call</soundCall>
				</li>
			</lifeStageAges>
		</race>
		<butcherProducts>
			<Steel>25</Steel>
		</butcherProducts>
		<comps>
			<li Class="VEF.AnimalBehaviours.CompProperties_Floating" MayRequire="OskarPotocki.VanillaFactionsExpanded.Core">
			</li>
		</comps>
	</ThingDef>

