              </li>
              <li Class="CombatExtended.ToolCE">
                <label>muzzle</label>
                <capacities>
                  <li>Poke</li>
                </capacities>
                <surpriseAttack>
                  <extraMeleeDamages />
                </surpriseAttack>
                <extraMeleeDamages />
