            </tools>
          </value>
        </li>
        <li Class="PatchOperationRemove">
          <xpath>Defs/ThingDef[defName="CH_MedicGun_MechRifle"]/verbs/li[verbClass="CombatHealing.Verb_ShootCH"]</xpath>
