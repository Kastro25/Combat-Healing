            <SwayFactor>0.33</SwayFactor>
            <ShotSpread>0.07</ShotSpread>
            <Recoil>0.8</Recoil>
            <MagazineCapacity>10</MagazineCapacity>
            <ReloadSpeed>0.4</ReloadSpeed>
            <AmmoGenPerMagOverride>10</AmmoGenPerMagOverride>
            <ReloadTime>0.4</ReloadTime>
          </statBases>
          <Properties>
            <verbClass>CombatHealing.CE.Verb_ShootCH_CE</verbClass>
            <hasStandardCommand>True</hasStandardCommand>
            <warmupTime>0.8</warmupTime>
