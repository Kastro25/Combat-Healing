          <xpath>Defs/ThingDef[defName="CH_MedicGun_MechRifle"]/comps</xpath>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="CH_MedicGun_MechRifle"]</xpath>
