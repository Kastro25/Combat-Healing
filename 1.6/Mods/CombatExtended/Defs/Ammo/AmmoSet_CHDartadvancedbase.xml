<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingCategoryDef>
    <defName>AmmoCategory_CHDartadvancedbase</defName>
    <label>large inyector darts</label>
    <parent>AmmoRifles</parent>
    <iconPath>UI/Icons/ThingCategories/CaliberCHDart</iconPath>
  </ThingCategoryDef>
  <CombatExtended.AmmoSetDef>
    <defName>AmmoSet_CHDartadvancedbase</defName>
