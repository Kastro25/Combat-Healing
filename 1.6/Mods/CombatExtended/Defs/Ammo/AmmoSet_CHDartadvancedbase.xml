    <researchPrerequisites>
				<li>CH_HyperHealingThesis</li>
				<li>PrecisionRifling</li>
		</researchPrerequisites>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>ComponentIndustrial</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Steel</li>
        <li>ComponentIndustrial</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <Ammo_CHDartadvancedbase_Inyector>100</Ammo_CHDartadvancedbase_Inyector>
