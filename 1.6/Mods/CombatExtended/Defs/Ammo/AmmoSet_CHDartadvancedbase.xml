  </CombatExtended.AmmoSetDef>
  <ThingDef Class="CombatExtended.AmmoDef" Name="Ammo_CHDartadvancedbase_Base" ParentName="MediumAmmoBase" Abstract="True">
    <description>A large dart propperly know as "chylinis dart", an internal mechanism allows it to efficiently inject stored liquid upon impact and then be safely expelled from the target, its arquitecture only permits it to be fired by Dartrifles</description>
    <statBases>
      <Mass>0.013</Mass>
      <Bulk>0.02</Bulk>
    </statBases>
    <tradeTags>
      <li>CE_AutoEnableTrade</li>
      <li>CE_AutoEnableCrafting</li>
    </tradeTags>
    <thingCategories>
      <li>AmmoCategory_CHDartadvancedbase</li>
    </thingCategories>
  </ThingDef>
  <ThingDef Name="Bullet_CHDartadvancedbase_Base" ParentName="BaseBulletCE" Abstract="True">
    <graphicData>
      <texPath>Things/Projectile/Dart_Advanced</texPath>
      <graphicClass>Verse.Graphic_Single</graphicClass>
    </graphicData>
    <projectile Class="CombatExtended.ProjectilePropertiesCE">
      <speed>100</speed>
      <damageDef>Bullet</damageDef>
      <dropsCasings>false</dropsCasings>
    </projectile>
  </ThingDef>
  <ThingDef Class="CombatExtended.AmmoDef" ParentName="Ammo_CHDartadvancedbase_Base">
