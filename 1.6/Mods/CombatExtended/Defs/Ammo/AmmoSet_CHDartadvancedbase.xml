      <texPath>Things/Ammo/Dart/chylinis</texPath>
      <graphicClass>Verse.Graphic_StackCount</graphicClass>
    </graphicData>
    <ammoClass>Nail</ammoClass>
    <cookOffProjectile>Bullet_CHDartadvancedbase_Inyector</cookOffProjectile>
  </ThingDef>
  <ThingDef ParentName="Bullet_CHDartadvancedbase_Base">
    <defName>Bullet_CHDartadvancedbase_Inyector</defName>
    <projectile Class="CombatExtended.ProjectilePropertiesCE">
      <damageAmountBase>1</damageAmountBase>
      <damageDef>CH_HealingAdvanced</damageDef>
      <armorPenetrationBlunt>0.355</armorPenetrationBlunt>
      <armorPenetrationSharp>0.35</armorPenetrationSharp>
      <speed>80</speed>
    </projectile>
  </ThingDef>
  <RecipeDef ParentName="AmmoRecipeBase">
