    <cookOffProjectile>Bullet_CHDartbasicbase_Inyector</cookOffProjectile>
  </ThingDef>
  <ThingDef ParentName="Bullet_CHDartbasicbase_Base">
    <defName>Bullet_CHDartbasicbase_Inyector</defName>
    <projectile Class="CombatExtended.ProjectilePropertiesCE">
      <damageAmountBase>1</damageAmountBase>
      <damageDef>CH_HealingBasic</damageDef>
      <armorPenetrationBlunt>0.355</armorPenetrationBlunt>
      <armorPenetrationSharp>0.35</armorPenetrationSharp>
      <speed>80</speed>
    </projectile>
  </ThingDef>
