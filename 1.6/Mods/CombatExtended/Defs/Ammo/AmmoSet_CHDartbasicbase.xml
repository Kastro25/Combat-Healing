  <ThingDef Class="CombatExtended.AmmoDef" Name="Ammo_CHDartbasicbase_Base" ParentName="SmallAmmoBase" Abstract="True">
    <description>A dart propperly know as "chynis dart", an internal mechanism allows it to efficiently inject stored liquid upon impact and then be safely expelled from the target, its arquitecture only permits it to be fired by Dartguns</description>
    <statBases>
      <Mass>0.013</Mass>
      <Bulk>0.02</Bulk>
    </statBases>
    <tradeTags>
      <li>CE_AutoEnableTrade</li>
      <li>CE_AutoEnableCrafting</li>
    </tradeTags>
    <thingCategories>
      <li>AmmoCategory_CHDartbasicbase</li>
    </thingCategories>
  </ThingDef>
  <ThingDef Name="Bullet_CHDartbasicbase_Base" ParentName="BaseBulletCE" Abstract="True">
    <graphicData>
      <texPath>Things/Projectile/Dart_Basic</texPath>
      <graphicClass>Verse.Graphic_Single</graphicClass>
    </graphicData>
    <projectile Class="CombatExtended.ProjectilePropertiesCE">
      <speed>100</speed>
      <damageDef>Bullet</damageDef>
      <dropsCasings>false</dropsCasings>
    </projectile>
